DEVFLOW_API_ENVIRONMENT=local
DEVFLOW_API_DEBUG=true
DEVFLOW_API_PROJECT_NAME="DevFlow Insight API"
DEVFLOW_API_API_V1_PREFIX=/api/v1
DEVFLOW_API_DATABASE_URL=postgresql+asyncpg://devflow:devflow@localhost:5432/devflow
DEVFLOW_API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# GitHub OAuth App — register your app at:
#   https://github.com/settings/developers → OAuth Apps → New OAuth App
# Set Authorization callback URL to: http://localhost:5173/integrations/github/callback
DEVFLOW_API_GITHUB_CLIENT_ID=
DEVFLOW_API_GITHUB_CLIENT_SECRET=
DEVFLOW_API_GITHUB_REDIRECT_URI=http://localhost:5173/integrations/github/callback
DEVFLOW_API_GITHUB_OAUTH_SCOPES=read:user,repo

# Fernet key for encrypting GitHub access tokens at rest.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVFLOW_API_GITHUB_TOKEN_ENCRYPTION_KEY=
