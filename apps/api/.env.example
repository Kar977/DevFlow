DEVFLOW_API_ENVIRONMENT=local
DEVFLOW_API_DEBUG=true
DEVFLOW_API_PROJECT_NAME="DevFlow Insight API"
DEVFLOW_API_API_V1_PREFIX=/api/v1
DEVFLOW_API_DATABASE_URL=postgresql+asyncpg://devflow:devflow@localhost:5432/devflow
DEVFLOW_API_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# JWT signing secret. Required to be >= 32 chars and non-default in staging/production
# (the app refuses to start otherwise — see core/config.py).
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
DEVFLOW_API_SECRET_KEY=changeme-dev-only-use-random-32-chars-in-prod

# Redis cache for metrics endpoints. Leave empty to fall back to an in-memory
# cache (fine for local dev / a single process; use Redis when running >1 API replica).
DEVFLOW_API_REDIS_URL=redis://localhost:6379/0

# Work sessions running longer than this are flagged as likely-forgotten in
# GET /tasks/sessions/active (warning only — nothing is stopped automatically).
DEVFLOW_API_LONG_RUNNING_SESSION_HOURS=6

# GitHub OAuth App — register your app at:
#   https://github.com/settings/developers → OAuth Apps → New OAuth App
# Set Authorization callback URL to: http://localhost:5173/integrations/github/callback
# Used for per-member identity linking (PR attribution); repository access itself
# goes through the GitHub App below.
DEVFLOW_API_GITHUB_CLIENT_ID=
DEVFLOW_API_GITHUB_CLIENT_SECRET=
DEVFLOW_API_GITHUB_REDIRECT_URI=http://localhost:5173/integrations/github/callback
DEVFLOW_API_GITHUB_OAUTH_SCOPES=read:user,repo

# Fernet key for encrypting GitHub access tokens at rest.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVFLOW_API_GITHUB_TOKEN_ENCRYPTION_KEY=

# GitHub App — used for org-level repository access, PR/review sync, and webhooks.
# Register your app at: https://github.com/settings/apps → New GitHub App
# All four are required together once DEVFLOW_API_GITHUB_APP_ID is set (see
# core/config.py's production validator). The private key is a PEM string;
# single-line env values may escape newlines as "\n".
DEVFLOW_API_GITHUB_APP_ID=
DEVFLOW_API_GITHUB_APP_SLUG=
DEVFLOW_API_GITHUB_APP_PRIVATE_KEY=
DEVFLOW_API_GITHUB_WEBHOOK_SECRET=
